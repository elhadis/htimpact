# Copy to .env.local for local development. Never commit real secrets.
# On Vercel, set these under Project Settings → Environment Variables.
# Replace DATABASE_URL with a hosted PostgreSQL connection string.
# Set NEXTAUTH_URL and AUTH_URL to the deployed https origin.
# AUTH_TRUST_HOST stays true behind Vercel's proxy.
# Leave every DEMO_* value empty in production.

DATABASE_URL="postgresql://htimpact:htimpact_local@127.0.0.1:54329/ht_impact_manager?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Local development only. The app refuses demo sign-in when NODE_ENV is production.
DEMO_LOGIN_ENABLED="false"
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
DEMO_STAFF_PASSWORD=""
