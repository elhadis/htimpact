# Copy to .env.local for local development. Never set demo variables in production.

DATABASE_URL="postgresql://htimpact:htimpact_local@127.0.0.1:54329/ht_impact_manager?schema=public"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Local development only. The app refuses demo sign-in when NODE_ENV is production.
DEMO_LOGIN_ENABLED="false"
DEMO_USER_EMAIL=""
DEMO_USER_PASSWORD=""
DEMO_STAFF_PASSWORD=""
